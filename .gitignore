```
# Android build artifacts
*.apk
*.aar
*.aab
*.so

# Gradle
.gradle/
build/
!gradle-wrapper.properties

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Android Studio
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/

# User-specific configurations
.idea/
*.iml
*.iws
*.suo
*.user
*.userosscache
*.sln.docstates

# Code coverage reports
coverage/
*.gcov
*.lcov
*.profdata

# Kotlin
*.kotlin_metadata

# Temporary folders for code compilation
*.class
*.dex

# Android generated files
gen/
out/

# Debug symbol files
*.map

# Backup files
*~

# Environment specific files
.env
.env.local
.env.*

# System files
.DS_Store
Thumbs.db

# Cache directories
.mypy_cache/
.pytest_cache/
__pycache__/
*.pyc
*.pyo
*.pyd
```