<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Modify" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/modify_background</item>
        <item name="android:navigationBarColor">@color/modify_background</item>
        <item name="android:windowBackground">@color/modify_background</item>
        <item name="android:colorPrimary">@color/modify_primary</item>
        <item name="android:colorPrimaryDark">@color/modify_background</item>
        <item name="android:colorAccent">@color/modify_secondary</item>
    </style>

    <style name="Theme.Modify.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/modify_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Modify</item>
    </style>
</resources>
